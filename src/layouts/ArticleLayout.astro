---
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, slugify } from '../data/site';
import { readingTime, formatDate, type Post } from '../lib/posts';
import type { MarkdownHeading } from 'astro';

interface Props { post: Post; headings: MarkdownHeading[]; related: Post[]; prev?: Post; next?: Post; }
const { post, headings, related, prev, next } = Astro.props;
const { data } = post;
const url = new URL(`/blog/${post.id}/`, SITE.url).href;
const minutes = readingTime(post.body);
const toc = headings.filter((h) => h.depth === 2);
const ogImage = data.image ?? `/og/blog/${post.id}.png`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    image: new URL(ogImage, SITE.url).href,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    author: { '@id': `${SITE.url}/#person` },
    publisher: { '@id': `${SITE.url}/#person` },
    mainEntityOfPage: url,
    articleSection: data.category,
    keywords: data.tags.join(', '),
    timeRequired: `PT${minutes}M`,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE.url + '/blog/' },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
];
const shareText = encodeURIComponent(data.title);
const shareUrl = encodeURIComponent(url);
---
<BaseLayout
  title={data.title}
  description={data.description}
  ogImage={ogImage}
  type="article"
  jsonLd={jsonLd}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate ?? data.pubDate}
  section={data.category}
  tags={data.tags}
>
  <article class="article">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / <a href={`/blog/category/${slugify(data.category)}/`}>{data.category}</a></nav>
    <header>
      <h1>{data.title}</h1>
      <div class="meta">
        <span>By {SITE.name}</span>
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
        {data.updatedDate && <span>Updated <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time></span>}
        <span>{minutes} min read</span>
      </div>
      <ul class="chips" aria-label="Tags" style="margin-top:.6rem">
        <li><a class="chip cat" href={`/blog/category/${slugify(data.category)}/`}>{data.category}</a></li>
        {data.tags.map((t) => <li><a class="chip" href={`/blog/tag/${slugify(t)}/`}>{t}</a></li>)}
      </ul>
    </header>

    {toc.length > 2 && (
      <details class="toc" open>
        <summary>On this page</summary>
        <ul class="toc-list">{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </details>
    )}

    <div class="prose"><slot /></div>

    <div class="share" data-url={url}>
      <span class="label">Share</span>
      <a class="btn btn-ghost" target="_blank" rel="noopener noreferrer" href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}>LinkedIn</a>
      <a class="btn btn-ghost" target="_blank" rel="noopener noreferrer" href={`https://x.com/intent/post?text=${shareText}&url=${shareUrl}`}>X</a>
      <button type="button" class="btn btn-ghost" id="copy-link">Copy link</button>
      <span class="status" role="status" aria-live="polite" id="copy-status"></span>
    </div>

    {(prev || next) && (
      <nav class="pager" aria-label="More articles">
        <div>{prev && <a href={`/blog/${prev.id}/`}>← {prev.data.title}</a>}</div>
        <div>{next && <a href={`/blog/${next.id}/`}>{next.data.title} →</a>}</div>
      </nav>
    )}
  </article>

  {related.length > 0 && (
    <section class="related" slot="after-main" aria-labelledby="related-h">
      <h2 id="related-h">Related articles</h2>
      <div class="grid">{related.map((p) => <ArticleCard post={p} />)}</div>
    </section>
  )}
<script is:inline>
  (function () {
    var btn = document.getElementById('copy-link');
    var status = document.getElementById('copy-status');
    var box = document.querySelector('.share');
    if (!btn || !box) return;
    btn.addEventListener('click', function () {
      var url = box.getAttribute('data-url');
      var done = function (m) { status.textContent = m; setTimeout(function () { status.textContent = ''; }, 2500); };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () { done('Link copied'); }, function () { done('Copy failed — copy it from the address bar'); });
      } else { done('Copy it from the address bar'); }
    });
  })();
</script>
</BaseLayout>
