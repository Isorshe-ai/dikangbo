---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getPosts, allTags } from '../../../lib/posts';
import { slugify } from '../../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return allTags(posts).map(([t]) => ({
    params: { tag: slugify(t) },
    props: { name: t, posts: posts.filter((p) => p.data.tags.includes(t)) },
  }));
}
const { name, posts } = Astro.props;
---
<BaseLayout title={`Tagged: ${name}`} description={`Articles tagged ${name} by David Ikangbo.`}>
  <p class="breadcrumb"><a href="/blog/">Blog</a> / Tag</p>
  <h1 class="page-title">#{name}</h1>
  <div class="grid">{posts.map((p) => <ArticleCard post={p} />)}</div>
</BaseLayout>
