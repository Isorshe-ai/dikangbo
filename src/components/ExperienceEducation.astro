---
import { education, experience, volunteering } from '../data/resume';
---
<section class="card section animate-on-scroll" id="experience">
  <p class="eyebrow"><span class="prompt">&gt;_</span> where I've been</p>
  <h2>Experience</h2>
  <div class="timeline">
    {experience.map((job) => (
      <div class="timeline-item">
        {job.date && <span class="timeline-date">{job.date}</span>}
        <h3>{job.role}</h3>
        <p class="role-company">
          {job.url ? <a href={job.url} rel="noopener" target="_blank">{job.company}</a> : job.company}
        </p>
        <ul>{job.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
      </div>
    ))}
  </div>
</section>

<section class="card section animate-on-scroll" id="volunteering">
  <p class="eyebrow"><span class="prompt">&gt;_</span> sharing what I learn</p>
  <h2>Volunteering &amp; Community</h2>
  <ul>{volunteering.map((item) => <li>{item}.</li>)}</ul>
</section>

<section class="card section animate-on-scroll" id="education">
  <p class="eyebrow"><span class="prompt">&gt;_</span> continuous learning</p>
  <h2>Education &amp; Training</h2>
  <ul>{education.map((item) => <li>{item}.</li>)}</ul>
</section>
