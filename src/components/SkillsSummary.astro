---
---
<section class="card section animate-on-scroll" id="about">
  <div class="section-heading">
    <div>
      <p class="eyebrow"><span class="prompt">&gt;_</span> about me</p>
      <h2>A little about my work</h2>
    </div>
    <div class="view-toggle" role="tablist" aria-label="About view">
      <button class="toggle-btn active" id="recruiter-tab" type="button" role="tab" aria-selected="true" aria-controls="recruiter-view" data-view="recruiter">Recruiter</button>
      <button class="toggle-btn" id="developer-tab" type="button" role="tab" aria-selected="false" aria-controls="developer-view" data-view="developer">Dev Mode</button>
    </div>
  </div>
  <div class="view-content" id="recruiter-view" role="tabpanel" aria-labelledby="recruiter-tab">
    <p class="about-copy">I am an experienced IT service delivery professional with over 8 years of expertise across DevOps, cloud infrastructure, software development, and IT support. I specialize in deploying scalable systems on AWS and GCP, managing hybrid environments, and driving operational efficiency in banking, healthcare, and NGO sectors. I am passionate about automation, security, and observability.</p>
  </div>
  <div class="view-content" id="developer-view" role="tabpanel" aria-labelledby="developer-tab" hidden>
    <pre class="profile-code"><code>&#123;
  "name": "David Ikangbo",
  "role": "DevOps Engineer",
  "experience": "8+ Years",
  "skills": ["AWS", "GCP", "Kubernetes", "Terraform", "Vault", "Python"],
  "mission": "Automating the boring stuff",
  "status": "Ready to deploy"
&#125;</code></pre>
  </div>
</section>

<section class="card section animate-on-scroll" id="skills">
  <p class="eyebrow"><span class="prompt">&gt;_</span> tools of the trade</p>
  <h2>Tech Stack</h2>
  <div class="skill-groups">
    <div class="skill-group">
      <h3>Cloud &amp; Infrastructure</h3>
      <ul class="skills-list">
        <li>AWS</li><li>Google Cloud</li><li>Cloud Logging</li><li>Cloud Monitoring</li>
        <li>Cloud Storage</li><li>BigQuery</li><li>Cloud Build</li><li>IAM</li>
        <li>Terraform / OpenTofu</li><li>CloudFormation</li>
      </ul>
    </div>
    <div class="skill-group">
      <h3>Platform &amp; Delivery</h3>
      <ul class="skills-list">
        <li>Kubernetes / GKE</li><li>Helm</li><li>Docker</li><li>GitHub Actions</li>
        <li>Private self-hosted runners</li><li>Concourse CI</li><li>DORA metrics</li><li>Git</li>
      </ul>
    </div>
    <div class="skill-group">
      <h3>On-Prem &amp; Hybrid Infrastructure</h3>
      <ul class="skills-list">
        <li>Proxmox VE</li><li>On-prem Kubernetes</li><li>Ansible</li><li>DHIS2</li>
        <li>Docker Compose</li><li>PostgreSQL / PostGIS</li><li>NGINX</li>
        <li>systemd</li><li>Let's Encrypt</li><li>Backup &amp; restore</li>
      </ul>
    </div>
  </div>
  <details class="read-more">
    <summary>
      <span class="read-more-label">Read more skills</span>
      <span class="read-less-label">Show fewer skills</span>
    </summary>
    <div class="skill-groups read-more-content">
      <div class="skill-group">
        <h3>Security &amp; Identity</h3>
        <ul class="skills-list">
          <li>HashiCorp Vault</li><li>Vault Secrets Operator</li><li>Keycloak</li>
          <li>OIDC</li><li>Secrets management</li><li>Least-privilege IAM</li>
        </ul>
      </div>
      <div class="skill-group">
        <h3>Reliability &amp; Observability</h3>
        <ul class="skills-list">
          <li>Prometheus</li><li>Grafana</li><li>Loki</li><li>Alloy</li>
          <li>Uptime Kuma</li><li>Alerting</li><li>FinOps</li><li>Incident response</li>
          <li>Backup &amp; restore</li>
        </ul>
      </div>
      <div class="skill-group">
        <h3>Automation &amp; Development</h3>
        <ul class="skills-list">
          <li>Python</li><li>Bash</li><li>Next.js</li><li>Redis</li><li>Celery</li><li>uWSGI</li>
          <li>WordPress</li><li>PHP</li><li>ACF</li><li>Power BI</li><li>Excel</li>
          <li>Linux</li><li>Windows</li><li>macOS</li>
        </ul>
      </div>
    </div>
  </details>
</section>
